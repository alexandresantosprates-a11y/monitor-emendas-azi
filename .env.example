# Chave de API do Portal da Transparência
# Solicitar em: https://api.portaldatransparencia.gov.br/swagger-ui.html
TRANSPARENCIA_API_KEY=sua_chave_aqui

# Configuração de e-mail (remetente)
EMAIL_REMETENTE=monitor@seudominio.com.br
EMAIL_SENHA=sua_senha_ou_app_password
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Destinatários do relatório mensal (separados por vírgula)
EMAIL_DESTINATARIOS=assessoria@pauloazi.com.br,comunicacao@pauloazi.com.br

# Identificação do parlamentar
# CPF ou código no sistema SIAFI/Portal da Transparência
PARLAMENTAR_NOME=PAULO AZI
PARLAMENTAR_CPF=
# Código do município da base: Salvador-BA = 2927408
# Lista de municípios monitorados (IBGE codes, separados por vírgula)
# Deixar vazio para monitorar todos os municípios da Bahia
MUNICIPIOS_BAHIA=

# Intervalo de coleta em horas (padrão: 24h)
COLETA_INTERVALO_HORAS=24
